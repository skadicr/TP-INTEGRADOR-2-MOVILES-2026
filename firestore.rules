rules_version = '2';

// Pegar estas reglas en Firebase Console > Firestore Database > Reglas > Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    // Viajes: cada documento tiene "userId" (uid del dueño).
    match /viajes/{viajeId} {
      // Leer y eliminar: solo el dueño del documento.
      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      // Crear: el documento nuevo debe quedar a nombre del usuario autenticado.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.descripcion is string
                    && request.resource.data.descripcion.size() >= 3;

      // Editar: solo el dueño, y no puede cambiar el userId.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.descripcion is string
                    && request.resource.data.descripcion.size() >= 3;
    }

    // Perfil: el documento usuarios/{uid} solo lo ve y edita su dueño.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás queda denegado por defecto.
  }
}
